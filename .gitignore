# Build products
build/
release/
*.o
*.lst
*.lbl
*.map

# Generated: tools/gen_tables.py emits this for the chosen output rate
src/tables.s

# Generated: tools/mkmod.py writes the synthetic test corpus
tests/mods/*.mod

# Third-party music. NOT ours to redistribute, and hundreds of megabytes.
# Point the sweep at your own collection locally instead.
tests/mods/real/

# A working copy of the SD card's player folder, including a module
# collection. Same reasoning: not ours to redistribute.
modp/

# Optional full upstream micromod clone (~20 MB, and only songs/ is of any
# use). The two files the oracle actually needs are vendored, with their
# licence, in vendor/micromod-c/.
vendor/micromod/
